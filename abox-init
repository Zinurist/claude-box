#!/bin/sh
# Entry point for every box (claude-box, opencode-box, pi-box), baked into
# the image:
#
#   abox-init COMMAND [ARG...]
#
# Runs as root *inside the box's user namespace* (not host root) with only
# SETUID, SETGID and SETPCAP (plus SYS_ADMIN for claude-box), does a little
# setup, then drops everything for good and runs COMMAND as uid 1000.
set -eu

# claude-box only: Claude Code names its peer-session files and sockets after
# its PID (~/.claude/sessions/<pid>.json, cc-socks/<pid>.sock). In a box that
# PID would always be the same, so every box would collide and none would be
# reachable. claude-box picks a PID that is free on the host and passes
# ABOX_NEXT_PID; writing it to ns_last_pid makes the next process forked in
# this PID namespace get ABOX_NEXT_PID + 1. The box still has its own PID
# namespace, so it sees none of the host's or other boxes' processes.
if [ -n "${ABOX_NEXT_PID:-}" ]; then
  if ! echo "$ABOX_NEXT_PID" >/proc/sys/kernel/ns_last_pid 2>/dev/null; then
    echo "abox-init: could not set the box PID; peer sessions may not see this one" >&2
  fi
fi
unset ABOX_NEXT_PID

# Give uid 1000 the host's user name instead of the image's "node", so
# whoami, ssh's default login name (`ssh host` = `ssh $USER@host`) and the
# like match the host. Only the name changes: the uid and /home/node stay, so
# every mount is unaffected. The image's own passwd/group are writable here
# (owned by the box's root); /etc/shadow is not without DAC_OVERRIDE and
# nothing in the box needs it.
u=${ABOX_HOST_USER:-}
unset ABOX_HOST_USER
case $u in
  '' | node | *[!a-z0-9_.-]* | [!a-z_]*) ;;
  *)
    if getent passwd "$u" >/dev/null || getent group "$u" >/dev/null; then
      echo "abox-init: user $u already exists in the box; keeping 'node'" >&2
    elif sed -i "s/^node:/$u:/" /etc/passwd /etc/group 2>/dev/null; then
      export USER="$u" LOGNAME="$u"
    else
      echo "abox-init: could not rename the box user to $u" >&2
    fi
    ;;
esac

if [ $# -eq 0 ]; then
  echo "abox-init: no command given" >&2
  exit 2
fi

# Drop to uid 1000 with no capabilities left (effective, permitted,
# inheritable, ambient and bounding all empty); no-new-privileges keeps it
# that way. The shell then *forks* COMMAND rather than exec'ing it, so it gets
# the chosen PID (claude-launch execs claude, keeping that PID).
#
# That shell stays PID 1 of the box. PID 1 gets no default signal handling,
# so it traps the stop signals and forwards them; otherwise `podman stop`
# would hang until SIGKILL and the tool could not shut down cleanly. `<&0`
# keeps the terminal as the tool's stdin, which a non-interactive shell would
# otherwise replace with /dev/null for a background job; the job stays in the
# terminal's foreground process group.
exec setpriv --reuid=1000 --regid=1000 --clear-groups \
  --inh-caps=-all --bounding-set=-all \
  bash -c '
    trap "kill -TERM \$child 2>/dev/null" TERM HUP INT
    "$@" <&0 &
    child=$!
    # wait returns early when a trapped signal arrives; keep waiting for
    # the real exit status.
    while :; do
      wait "$child"
      status=$?
      kill -0 "$child" 2>/dev/null || exit "$status"
    done
  ' abox-init "$@"
