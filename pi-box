#!/usr/bin/env bash
set -euo pipefail
. "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/agent-box-lib.sh"
abox_parse "$@"
mkdir -p ~/.pi
exec podman run "${ABOX_COMMON[@]}" "${ABOX_MOUNTS[@]}" \
  -v "$HOME/.pi:/home/node/.pi:z" \
  -e ANTHROPIC_API_KEY \
  -e OPENAI_API_KEY \
  -e GEMINI_API_KEY \
  -e GOOGLE_GENERATIVE_AI_API_KEY \
  -e OPENROUTER_API_KEY \
  -e GROQ_API_KEY \
  agent-box:latest pi "${ABOX_ARGS[@]}"
