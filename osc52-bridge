#!/usr/bin/python3 -I
"""osc52-bridge COMMAND [ARG...]

Runs COMMAND on a pseudo-terminal and relays everything between it and the
real terminal unchanged. On the way out it watches for OSC 52 clipboard
writes (ESC ] 52 ; <sel> ; <base64> BEL|ESC \\) and hands their contents to
wl-copy.

Why: full-screen TUIs like opencode capture the mouse (they need it for
scrolling), so the terminal can't select text itself, and they copy their own
selections only via OSC 52. VTE terminals (GNOME Terminal, ddterm) ignore OSC
52, so the copy silently goes nowhere. The sequence is still passed through,
so terminals that do support it keep working.

Without a terminal on stdin/stdout it just execs COMMAND.
"""
import base64
import fcntl
import os
import pty
import select
import shutil
import signal
import subprocess
import sys
import termios
import tty

START = b"\x1b]52;"
MAX_PAYLOAD = 16 * 1024 * 1024


def copy_to_clipboard(body: bytes) -> None:
    # body is "<selection>;<base64>"; "?" is a query, not a write.
    try:
        _sel, data = body.split(b";", 1)
    except ValueError:
        return
    if not data or data == b"?":
        return
    try:
        text = base64.b64decode(data, validate=False)
    except Exception:
        return
    if not shutil.which("wl-copy") or not os.environ.get("WAYLAND_DISPLAY"):
        return
    try:
        # wl-copy forks a background process that serves the clipboard; the
        # foreground one exits right away.
        subprocess.run(["wl-copy"], input=text, timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


class Scanner:
    """Finds OSC 52 sequences in a byte stream that arrives in chunks."""

    def __init__(self):
        self.buf = b""
        self.inside = False

    def feed(self, chunk: bytes) -> None:
        self.buf += chunk
        while True:
            if not self.inside:
                i = self.buf.find(START)
                if i < 0:
                    # Keep a possible partial start sequence for the next chunk.
                    self.buf = self.buf[-(len(START) - 1):]
                    return
                self.buf = self.buf[i + len(START):]
                self.inside = True
            ends = [(j, n) for j, n in ((self.buf.find(b"\x07"), 1),
                                        (self.buf.find(b"\x1b\\"), 2)) if j >= 0]
            if not ends:
                if len(self.buf) > MAX_PAYLOAD:
                    self.buf, self.inside = b"", False
                return
            j, n = min(ends)
            copy_to_clipboard(self.buf[:j])
            self.buf = self.buf[j + n:]
            self.inside = False


def write_all(fd: int, data: bytes) -> None:
    while data:
        data = data[os.write(fd, data):]


def main() -> int:
    argv = sys.argv[1:]
    if not argv:
        print("usage: osc52-bridge COMMAND [ARG...]", file=sys.stderr)
        return 2
    if not (os.isatty(0) and os.isatty(1)):
        os.execvp(argv[0], argv)

    pid, master = pty.fork()
    if pid == 0:
        try:
            os.execvp(argv[0], argv)
        except OSError as e:
            print(f"osc52-bridge: {argv[0]}: {e}", file=sys.stderr)
        os._exit(127)

    def sync_size(*_):
        try:
            size = fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8)
            fcntl.ioctl(master, termios.TIOCSWINSZ, size)
        except OSError:
            pass

    def forward(signum, _frame):
        try:
            os.kill(pid, signum)
        except ProcessLookupError:
            pass

    sync_size()
    signal.signal(signal.SIGWINCH, sync_size)
    for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(s, forward)

    saved = termios.tcgetattr(0)
    tty.setraw(0)
    scanner = Scanner()
    fds = [0, master]
    try:
        while True:
            try:
                ready, _, _ = select.select(fds, [], [])
            except InterruptedError:
                continue
            if master in ready:
                try:
                    data = os.read(master, 65536)
                except OSError:  # EIO: the child closed the terminal
                    break
                if not data:
                    break
                write_all(1, data)
                scanner.feed(data)
            if 0 in ready:
                data = os.read(0, 65536)
                if data:
                    write_all(master, data)
                else:
                    fds.remove(0)
    finally:
        termios.tcsetattr(0, termios.TCSAFLUSH, saved)

    _, status = os.waitpid(pid, 0)
    return os.waitstatus_to_exitcode(status) if hasattr(os, "waitstatus_to_exitcode") else status >> 8


if __name__ == "__main__":
    code = main()
    sys.exit(128 - code if code < 0 else code)
