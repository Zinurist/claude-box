#!/usr/bin/env bash
set -euo pipefail
. "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/agent-box-lib.sh"

# opencode-box [--docker] [--shell] [PATH...] [-- CLI_ARG...]
# Everything common to the boxes is set up in agent-box-lib.sh.
abox_setup "$@"
mkdir -p ~/.config/opencode ~/.local/share/opencode ~/.local/state/opencode ~/.cache/opencode

# Use the host's opencode (official installer location) over the copy baked
# into the image, so updating opencode on the host updates the box too, without
# rebuilding. Read-only: `opencode upgrade` inside the box can't touch it.
if [ -x "$HOME/.opencode/bin/opencode" ]; then
  ABOX_EXTRA+=(-v "$(readlink -f -- "$HOME/.opencode/bin/opencode"):/usr/local/bin/opencode:ro,z")
else
  echo "opencode-box: no host opencode in ~/.opencode/bin; using the image's copy" >&2
fi

ABOX_EXTRA+=(
  -v "$HOME/.config/opencode:/home/node/.config/opencode:z"
  -v "$HOME/.local/share/opencode:/home/node/.local/share/opencode:z"
  # model.json (recent/favorite models, so the last pick sticks), prompt
  # history and other TUI state.
  -v "$HOME/.local/state/opencode:/home/node/.local/state/opencode:z"
  -v "$HOME/.cache/opencode:/home/node/.cache/opencode:z"
  -e ANTHROPIC_API_KEY
  -e OPENAI_API_KEY
  -e GEMINI_API_KEY
  -e GOOGLE_GENERATIVE_AI_API_KEY
  -e OPENROUTER_API_KEY
  -e GROQ_API_KEY
)
# Default model, applied on top of ~/.config/opencode via opencode's
# OPENCODE_CONFIG_CONTENT (a `model` there beats the last-used one; `-m` on
# the command line still beats both). Set OPENCODE_BOX_MODEL= to use plain
# config, or OPENCODE_CONFIG_CONTENT yourself to replace this.
model=${OPENCODE_BOX_MODEL-zinufgame-llama/qwen3.8-27b-128k}
if [ -z "${OPENCODE_CONFIG_CONTENT:-}" ] && [ -n "$model" ]; then
  ABOX_EXTRA+=(-e "OPENCODE_CONFIG_CONTENT={\"model\":\"$model\"}")
else
  ABOX_EXTRA+=(-e OPENCODE_CONFIG_CONTENT)
fi

# opencode copies its selections only via OSC 52, which VTE terminals (GNOME
# Terminal, ddterm) ignore; osc52-bridge turns those into wl-copy calls.
cmd=(osc52-bridge opencode)
[ "$ABOX_SHELL" -eq 1 ] && cmd=(bash)
abox_run "${cmd[@]}" "${ABOX_ARGS[@]}"
